<!-- ── CHEFS ── -->
<section id="chefs" style="background:var(--cream);padding:7rem 5%;">
  <div class="chefs-intro reveal">
    <span class="section-label">The Masters</span>
    <h2 class="section-title">The karigars behind<br><em>every flame</em></h2>
    <p class="section-body" style="margin-top:1rem;">Our kitchen is led by a team of award-winning culinary artists whose combined mastery spans India's greatest culinary traditions.</p>
  </div>
  <div class="chefs-grid reveal">
    {{#each chefs}}
    <div class="chef-card">
      <div class="chef-portrait">
        {{this.emoji}}
        <div class="chef-badge">{{this.badge}}</div>
        <div class="chef-award">{{this.award}}</div>
      </div>
      <div class="chef-name">{{this.name}}</div>
      <div class="chef-role">{{this.role}}</div>
      <p class="chef-bio">{{this.bio}}</p>
    </div>
    {{/each}}
  </div>
</section>

<!-- ── TESTIMONIALS ── -->
<section id="testimonials" style="background:var(--parchment);padding:7rem 5%;">
  <div class="testi-header reveal">
    <div class="testi-stars-row">
      <span class="stars">★★★★★</span>
      <span class="rating-text">4.8 · 3,200+ Reviews</span>
    </div>
    <span class="section-label muted" style="display:block;text-align:center;">Guest Reviews</span>
    <h2 class="section-title" style="text-align:center;">Words from our <em>guests</em></h2>
  </div>
  <div class="testi-grid reveal">
    {{#each testimonials}}
    <div class="testi-card">
      <div class="testi-stars">{{this.stars}}</div>
      <div class="testi-quote-mark">"</div>
      <p class="testi-text">{{this.text}}</p>
      <div class="testi-footer">
        <div class="testi-avatar">{{this.initials}}</div>
        <div>
          <div class="testi-name">{{this.name}}</div>
          <div class="testi-source">{{this.source}}</div>
        </div>
      </div>
    </div>
    {{/each}}
  </div>
</section>

<!-- ── RESERVATIONS (Home Section) ── -->
<section id="reservations" style="background:var(--cream);padding:7rem 5%;display:grid;grid-template-columns:1fr 1fr;gap:7rem;align-items:start;">
  <div class="res-text reveal-left">
    <span class="section-label">Reserve a Table</span>
    <h2 class="section-title">Join us for an<br><em>unforgettable</em><br>Indian evening</h2>
    <div class="ornament" style="margin-top:1.2rem;"><div class="ornament-gem"></div></div>
    <p class="section-body">We recommend booking at least 3 days in advance for weekends. For wedding parties, corporate events, or groups of 10+, please call us directly.</p>
    <div class="hours-grid" style="margin-top:2rem;">
      <div class="hour-cell"><div class="hour-day">Mon – Thu</div><div class="hour-time">12:00 – 11:00 PM</div></div>
      <div class="hour-cell"><div class="hour-day">Fri – Sat</div><div class="hour-time">12:00 – 11:30 PM</div></div>
      <div class="hour-cell"><div class="hour-day">Sunday</div><div class="hour-time">12:00 – 10:30 PM</div></div>
      <div class="hour-cell"><div class="hour-day">Lunch (Daily)</div><div class="hour-time">12:00 – 3:30 PM</div></div>
    </div>
    <div class="res-extras">
      <div class="res-extra"><span class="icon">👔</span> Smart casual attire requested</div>
      <div class="res-extra"><span class="icon">💒</span> Wedding & engagement parties welcome</div>
      <div class="res-extra"><span class="icon">🏢</span> Corporate dining & team celebrations</div>
      <div class="res-extra"><span class="icon">🎁</span> Gift vouchers available at reception</div>
    </div>
  </div>
  <div class="res-form-card reveal-right">
    <h3>Make a Reservation</h3>
    <p>Secure your table in under 60 seconds</p>
    <form id="reservationForm">
      <div class="form-row-2">
        <div class="form-grp"><label class="form-lbl">First Name *</label><input type="text" name="firstName" class="form-inp" placeholder="Arjun" required></div>
        <div class="form-grp"><label class="form-lbl">Last Name</label><input type="text" name="lastName" class="form-inp" placeholder="Sharma"></div>
      </div>
      <div class="form-grp"><label class="form-lbl">Email Address *</label><input type="email" name="email" class="form-inp" placeholder="arjun@example.com" required></div>
      <div class="form-grp"><label class="form-lbl">Mobile Number *</label><input type="tel" name="phone" class="form-inp" placeholder="+91 98765 43210" required></div>
      <div class="form-row-2">
        <div class="form-grp"><label class="form-lbl">Date *</label><input type="date" name="date" class="form-inp" required></div>
        <div class="form-grp">
          <label class="form-lbl">Preferred Time</label>
          <select name="time" class="form-sel">
            <option>12:00 PM</option><option>12:30 PM</option><option>1:00 PM</option>
            <option>7:00 PM</option><option>7:30 PM</option><option selected>8:00 PM</option>
            <option>8:30 PM</option><option>9:00 PM</option><option>9:30 PM</option><option>10:00 PM</option>
          </select>
        </div>
      </div>
      <div class="form-row-2">
        <div class="form-grp">
          <label class="form-lbl">Guests *</label>
          <select name="guests" class="form-sel" required>
            <option>1 Guest</option><option>2 Guests</option><option selected>3–4 Guests</option>
            <option>5–6 Guests</option><option>7–10 Guests</option><option>Large Party (10+)</option>
          </select>
        </div>
        <div class="form-grp">
          <label class="form-lbl">Occasion</label>
          <select name="occasion" class="form-sel">
            <option value="">Select (optional)</option>
            <option>Anniversary</option><option>Birthday</option><option>Wedding Party</option>
            <option>Engagement</option><option>Corporate Dinner</option><option>Other Celebration</option>
          </select>
        </div>
      </div>
      <div class="form-grp"><label class="form-lbl">Special Requests</label><textarea name="requests" class="form-txt" placeholder="Dietary needs, high chair, vegetarian preference, wine pairing…"></textarea></div>
      <button type="submit" class="form-btn" id="resBtn">Reserve My Table →</button>
      <p class="form-note">🔒 Your details are secure and never shared. Confirmation via SMS & email within 15 minutes.</p>
    </form>
    <div id="resSuccess" style="display:none;text-align:center;padding:2rem 0;">
      <div style="font-size:2.5rem;margin-bottom:1rem;">🎉</div>
      <h4 style="font-family:'Playfair Display',serif;font-size:1.5rem;color:var(--cream);margin-bottom:0.5rem;">Table Reserved!</h4>
      <p id="resMessage" style="color:rgba(247,242,234,0.5);font-size:0.85rem;font-weight:300;"></p>
    </div>
  </div>
</section>

<!-- ── NEWSLETTER ── -->
<div id="newsletter">
  <div class="nl-text reveal">
    <h3>Stay at our table.<br>Never miss a season.</h3>
    <p>New seasonal menus, chef's table events, wine & spirits evenings — straight to your inbox.</p>
  </div>
  <div class="nl-form reveal">
    <input class="nl-input" type="email" placeholder="Your email address" id="nlEmail">
    <button class="nl-btn" onclick="subscribeNL(this)">Subscribe</button>
  </div>
</div>

