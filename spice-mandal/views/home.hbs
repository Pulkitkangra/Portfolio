<!-- ── HERO ── -->
<section class="hero" id="home">
  <div class="hero-mesh"></div>
  <div class="hero-grain"></div>
  <div class="hero-grid-lines"></div>
  <div class="hero-paisley"></div>
  <div class="hero-vignette"></div>
  <div class="hero-content">
    <div class="hero-eyebrow">Authentic Indian Fine Dining · Est. {{restaurant.established}} · New Delhi</div>
    <h1>Spice<br><em>&amp;</em> <span>Soul</span></h1>
    <div class="hero-divider"></div>
    <p class="hero-tagline">Royal Awadhi Cuisine · Live Tandoor Kitchen · Connaught Place</p>
    <div class="hero-actions">
      <a class="btn-hero" href="/reservation">Reserve Your Table ↗</a>
      <a class="btn-hero-ghost" href="/menu">Explore Menu</a>
    </div>
    <div class="hero-badges">
      {{#each awards}}
      <div class="hero-badge">
        <span class="badge-icon">{{this.icon}}</span>
        <span class="badge-text">{{this.label}}</span>
      </div>
      {{#unless @last}}<div class="hero-badge-sep"></div>{{/unless}}
      {{/each}}
    </div>
  </div>
  <div class="hero-scroll">
    <div class="hero-scroll-text">Scroll</div>
    <div class="scroll-mouse"><div class="scroll-wheel"></div></div>
  </div>
</section>

<!-- INFO STRIP -->
<div class="info-strip">
  <div class="strip-item"><span class="s-icon">⏰</span> Mon – Sat · 12:00 PM – 11:30 PM</div>
  <div class="strip-sep"></div>
  <div class="strip-item"><span class="s-icon">📍</span> 12, Connaught Place, New Delhi</div>
  <div class="strip-sep"></div>
  <div class="strip-item"><span class="s-icon">📞</span> +91 98765 43210</div>
  <div class="strip-sep"></div>
  <div class="strip-item"><span class="s-icon">🌶️</span> 60+ Heritage Recipes</div>
  <div class="strip-sep"></div>
  <div class="strip-item"><span class="s-icon">🌿</span> 100% Organic Ingredients</div>
</div>

<!-- ── ABOUT ── -->
<section id="about">
  <div class="about-visual">
    <div class="about-art">
      <div class="mandala-wrap">
        <div class="mandala-ring outer"></div>
        <div class="mandala-ring middle"></div>
        <div class="mandala-ring inner"></div>
        <div class="mandala-center">🪔</div>
      </div>
    </div>
    <div class="about-card top-right">
      <div class="card-num">12<span class="accent">+</span></div>
      <div class="card-label">Years of Mastery</div>
    </div>
    <div class="about-card bottom-left">
      <div class="card-num">60<span class="accent">k</span></div>
      <div class="card-label">Guests Delighted</div>
    </div>
    <div class="award-badge-circle">
      <span class="ab-star">⭐</span>
      <span class="ab-text">Times Food<br>Award</span>
    </div>
  </div>
  <div class="about-text reveal-right">
    <span class="section-label">Our Story</span>
    <h2 class="section-title">Born from spice,<br><em>rooted</em> in tradition</h2>
    <div class="ornament"><div class="ornament-gem"></div></div>
    <p class="section-body">Spice Mandal was founded in 2012 with one unwavering purpose — to bring India's endangered royal recipes back to the table. Our kitchen draws from the Mughal courts of Lucknow, the Rajput kitchens of Rajasthan, and the coastal homes of Kerala, treating every dish as a living piece of cultural heritage.</p>
    <p class="section-body" style="margin-top:1rem;">We source 100% organic ingredients from partner farms in Himachal, Kerala, and Rajasthan. Our spice blends are ground fresh daily. Our bread is hand-shaped and fired in a 480°C clay tandoor — exactly as it has been for centuries.</p>
    <div class="checklist" style="margin-top:1.8rem;">
      <div class="check-item"><div class="check-diamond"></div> 60+ heirloom recipes from India's royal culinary lineage</div>
      <div class="check-item"><div class="check-diamond"></div> 100% organic, farm-to-table produce sourced pan-India</div>
      <div class="check-item"><div class="check-diamond"></div> Traditional clay tandoor fired to 480°C daily</div>
      <div class="check-item"><div class="check-diamond"></div> Private dining for intimate gatherings and weddings</div>
    </div>
    <div class="about-stats">
      <div class="about-stat">
        <div class="num">60<sub>k</sub></div>
        <div class="lbl">Guests Served</div>
      </div>
      <div class="about-stat">
        <div class="num">8<sub>+</sub></div>
        <div class="lbl">Awards Won</div>
      </div>
      <div class="about-stat">
        <div class="num">4.8<sub>★</sub></div>
        <div class="lbl">Google Rating</div>
      </div>
    </div>
    <div style="margin-top:2.5rem;">
      <a class="btn-primary" href="/about">Our Full Story →</a>
    </div>
  </div>
</section>

<!-- ── MENU PREVIEW ── -->
<section id="menu-preview" style="background:var(--charcoal);padding:7rem 5%;">
  <div class="menu-top reveal">
    <div>
      <span class="section-label gold">Seasonal Menu</span>
      <h2 class="section-title light">Crafted with <em>spice</em><br>and devotion</h2>
    </div>
    <div class="menu-tabs">
      <button class="tab-btn active" onclick="switchMenu(this,'starters')">Starters</button>
      <button class="tab-btn" onclick="switchMenu(this,'mains')">Mains</button>
      <button class="tab-btn" onclick="switchMenu(this,'desserts')">Desserts</button>
      <button class="tab-btn" onclick="switchMenu(this,'drinks')">Drinks</button>
    </div>
  </div>

  <div class="menu-grid reveal" id="menuGrid">
    {{#each menu.starters}}
    <div class="menu-item" data-cat="starters">
      <div>
        <span class="item-tag">{{this.tag}}</span>
        <div class="item-name">{{this.name}}</div>
        <div class="item-desc">{{this.desc}}</div>
        <div class="item-allergens">{{#each this.badges}}<span class="allergen">{{this}}</span>{{/each}}</div>
      </div>
      <div class="item-price">{{this.price}}</div>
    </div>
    {{/each}}
    {{#each menu.mains}}
    <div class="menu-item" data-cat="mains" style="display:none">
      <div>
        <span class="item-tag">{{this.tag}}</span>
        <div class="item-name">{{this.name}}</div>
        <div class="item-desc">{{this.desc}}</div>
        <div class="item-allergens">{{#each this.badges}}<span class="allergen">{{this}}</span>{{/each}}</div>
      </div>
      <div class="item-price">{{this.price}}</div>
    </div>
    {{/each}}
    {{#each menu.desserts}}
    <div class="menu-item" data-cat="desserts" style="display:none">
      <div>
        <span class="item-tag">{{this.tag}}</span>
        <div class="item-name">{{this.name}}</div>
        <div class="item-desc">{{this.desc}}</div>
        <div class="item-allergens">{{#each this.badges}}<span class="allergen">{{this}}</span>{{/each}}</div>
      </div>
      <div class="item-price">{{this.price}}</div>
    </div>
    {{/each}}
    {{#each menu.drinks}}
    <div class="menu-item" data-cat="drinks" style="display:none">
      <div>
        <span class="item-tag">{{this.tag}}</span>
        <div class="item-name">{{this.name}}</div>
        <div class="item-desc">{{this.desc}}</div>
      </div>
      <div class="item-price">{{this.price}}</div>
    </div>
    {{/each}}
  </div>
  <p class="menu-note">Menu changes with India's seasons. Please inform us of any dietary requirements when booking.<br>V = Vegetarian · VG = Vegan · GF = Gluten Free · DF = Dairy Free</p>
  <div class="menu-view-full">
    <a class="btn-outline-light" href="/menu">View Full Menu →</a>
  </div>
</section>

<!-- ── EXPERIENCES ── -->
