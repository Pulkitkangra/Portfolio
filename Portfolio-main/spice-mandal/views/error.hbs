<section style="min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;background:var(--charcoal);padding:2rem;">
  <div>
    <div style="font-size:4rem;margin-bottom:1rem;">⚠️</div>
    <h1 style="font-family:'Playfair Display',serif;font-size:3rem;color:var(--cream);margin-bottom:1rem;">Something went wrong</h1>
    <p style="color:rgba(247,242,234,0.4);margin-bottom:2rem;font-weight:300;">{{message}}</p>
    <a href="/" style="display:inline-block;background:var(--saffron);color:var(--white);padding:0.85rem 2rem;border-radius:2px;text-decoration:none;font-size:0.8rem;letter-spacing:2px;text-transform:uppercase;">Back to Home</a>
  </div>
</section>
